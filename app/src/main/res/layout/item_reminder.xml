<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <TextView
            android:id="@+id/textReminderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            tools:text="Check in to hotel" />

        <TextView
            android:id="@+id/textReminderType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Hotel Booking" />

        <TextView
            android:id="@+id/textReminderDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_size_body"
            tools:text="2026-10-12 at 14:00" />

        <TextView
            android:id="@+id/textReminderNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_size_body"
            tools:text="Reservation number: 12345" />

        <Button
            android:id="@+id/buttonCancelReminder"
            style="@style/AppButton.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:text="@string/label_cancel_reminder"
            android:textColor="@color/danger" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
