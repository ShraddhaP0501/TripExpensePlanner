<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".TripDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_small"
            android:paddingTop="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_large">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_back"
                android:padding="@dimen/padding_small"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/textTripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="@dimen/touch_target_min"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="Goa Trip" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_medium"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/cardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_destination"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/textDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_medium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subtitle"
                    tools:text="Goa, India" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_start_date"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/textStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_medium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subtitle"
                    tools:text="2026-10-10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_end_date"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/textEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_medium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subtitle"
                    tools:text="2026-10-15" />

                <TextView
                    android:id="@+id/labelNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_notes"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/textNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subtitle"
                    tools:text="Remember to carry sunscreen." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_small"
            android:text="@string/label_trip_sections"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonItinerary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="@string/label_itinerary"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/buttonExpenses"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="@string/label_trip_expenses"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonParticipants"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="@string/label_participants"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/buttonTripSummary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="@string/label_trip_summary"
                android:textColor="@color/white" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonReminders"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:backgroundTint="@color/primary"
            android:text="@string/label_reminders"
            android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_large"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonEditTrip"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:text="@string/label_edit_trip"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/buttonDeleteTrip"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/padding_small"
                android:layout_weight="1"
                android:backgroundTint="@color/danger"
                android:text="@string/label_delete_trip"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
