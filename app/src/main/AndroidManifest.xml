<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to actually show a notification on Android 13+ (API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to schedule a reminder to fire at an exact time on Android 12+ (API 31). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets scheduled reminders survive a device restart (see BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TripExpensePlanner">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddTripActivity"
            android:exported="false"
            android:label="@string/title_add_trip" />

        <activity
            android:name=".MyTripsActivity"
            android:exported="false"
            android:label="@string/title_my_trips" />

        <activity
            android:name=".TripDetailsActivity"
            android:exported="false"
            android:label="@string/title_trip_details" />

        <activity
            android:name=".PlaceholderActivity"
            android:exported="false" />

        <activity
            android:name=".ItineraryActivity"
            android:exported="false"
            android:label="@string/label_itinerary" />

        <activity
            android:name=".AddEditActivityActivity"
            android:exported="false" />

        <activity
            android:name=".ExpensesActivity"
            android:exported="false"
            android:label="@string/label_trip_expenses" />

        <activity
            android:name=".AddEditExpenseActivity"
            android:exported="false" />

        <activity
            android:name=".ParticipantsActivity"
            android:exported="false"
            android:label="@string/label_participants" />

        <activity
            android:name=".AddEditParticipantActivity"
            android:exported="false" />

        <activity
            android:name=".TripSummaryActivity"
            android:exported="false"
            android:label="@string/label_trip_summary" />

        <activity
            android:name=".RemindersActivity"
            android:exported="false"
            android:label="@string/label_reminders" />

        <activity
            android:name=".AddReminderActivity"
            android:exported="false"
            android:label="@string/title_add_reminder" />

        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
